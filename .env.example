# Copy to .env and fill in. .env is gitignored; never commit real keys.
# In production these are set as Render environment variables instead.

# How labels are read: dual (LLM + OCR cross-check), llm (LLM only), ocr (offline only)
EXTRACTOR_MODE=dual

# OpenAI-compatible vision endpoint. This project uses Kimi (Moonshot AI) everywhere, for
# cost; an agency deployment would point these at Azure OpenAI in its own tenant instead.
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=kimi-k3.1-pro-highspeed
# Kimi's k3 models always think; "low" keeps that to a few tokens. Leave empty for models
# that take a thinking switch instead (kimi-k2.6, with LLM_DISABLE_THINKING=true).
LLM_REASONING_EFFORT=low
# Seconds to wait for the first token, and for the whole reply, before OCR reads alone.
LLM_FIRST_TOKEN_TIMEOUT=15
LLM_TOTAL_TIMEOUT=25
LLM_API_KEY=

# Serve /docs and /openapi.json (local development only)
ENABLE_DOCS=false

# Proxy IPs trusted for X-Forwarded-For. Set to * on Render (only reachable through its proxy).
FORWARDED_ALLOW_IPS=127.0.0.1
