# Copy to .env and fill in. .env is gitignored; never commit real keys.
# In production these are set as Render environment variables instead.

# How labels are read: dual (LLM + OCR cross-check), llm (LLM only), ocr (offline only)
EXTRACTOR_MODE=dual

# OpenAI-compatible vision endpoint.
#   Dev  (Moonshot): LLM_BASE_URL=https://api.moonshot.ai/v1
#   Prod (OpenAI):   LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Serve /docs and /openapi.json (local development only)
ENABLE_DOCS=false

# Proxy IPs trusted for X-Forwarded-For. Set to * on Render (only reachable through its proxy).
FORWARDED_ALLOW_IPS=127.0.0.1
