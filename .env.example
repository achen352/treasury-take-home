# Copy to .env and fill in. .env is gitignored; never commit real keys.
# In production these come from fly.toml, and secrets from `fly secrets set`.

# How labels are read: dual (LLM + OCR cross-check), llm (LLM only), ocr (offline only)
EXTRACTOR_MODE=dual

# OpenAI-compatible vision endpoint. The demo uses OpenAI; an agency deployment would point
# these at Azure OpenAI in its own tenant instead.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
# Reasoning models take an effort; "low" keeps the reasoning short. Leave empty for models
# without one.
LLM_REASONING_EFFORT=low
# Seconds to wait for the first token, and for the whole reply, before OCR reads alone.
LLM_FIRST_TOKEN_TIMEOUT=15
LLM_TOTAL_TIMEOUT=25
# Kimi (Moonshot AI) works too, for example:
#   LLM_BASE_URL=https://api.moonshot.ai/v1
#   LLM_MODEL=kimi-k2.6
#   LLM_REASONING_EFFORT=
#   LLM_DISABLE_THINKING=true

# The SHA-256 of the demo's access code (python -m scripts.access_code). Empty: the site is open.
ACCESS_CODE_SHA256=

# Serve /docs and /openapi.json (local development only)
ENABLE_DOCS=false

# Proxy IPs trusted for X-Forwarded-For. Set to * behind a hosting proxy (Fly).
# A header the proxy sets to the client's address, for the rate limits (Fly: fly-client-ip).
CLIENT_IP_HEADER=
# In production, refuse to start without ACCESS_CODE_SHA256.
REQUIRE_ACCESS_CODE=false
FORWARDED_ALLOW_IPS=127.0.0.1
